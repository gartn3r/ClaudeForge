{
  "compilerOptions": {
    "composite": true,
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": [
    "src/main/**/*",
    "src/preload/**/*",
    "src/backend/**/*",
    "src/shared/**/*",
    "test/**/*",
    "electron.vite.config.mts",
    "vitest.config.mts",
    "playwright.config.mts",
    "playwright.packaged.config.mts"
  ]
}
